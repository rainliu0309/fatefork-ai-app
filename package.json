{
  "name": "fatefork-ai-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Fate Fork｜命运岔途 — a controlled multimodal narrative tool for reflective decision-making.",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite --config client/vite.config.ts",
    "dev:server": "tsx watch server/index.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --config client/vite.config.ts",
    "build:sites": "vite build --config sites/vite.config.ts && node scripts/prepare-sites-build.mjs",
    "build:server": "tsc -p server/tsconfig.json",
    "start": "tsx server/index.ts",
    "typecheck": "tsc -p client/tsconfig.json && tsc -p server/tsconfig.json",
    "test": "node --import tsx --test server/**/*.test.ts",
    "lint": "eslint client/src server"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.536.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.0",
    "tailwind-merge": "^3.3.1",
    "tsx": "^4.20.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.48.0",
    "@eslint/js": "^9.32.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.2.1",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vite": "^7.1.2",
    "wrangler": "^4.115.0"
  }
}
