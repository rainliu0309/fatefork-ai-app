# Fate Fork local environment template.
# Copy this file to `.env`; never commit the real API key.

# ---------------------------------------------------------------------------
# Express
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=8787
# Comma-separate multiple browser origins when the API is used cross-origin.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
JSON_BODY_LIMIT=12mb
API_RATE_LIMIT_PER_MINUTE=90

# ---------------------------------------------------------------------------
# Agnes AIGC gateway (server-side only)
# ---------------------------------------------------------------------------
# Leave AGNES_API_KEY empty to run with the deterministic local mock provider.
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_TEXT_MODEL=agnes-2.0-flash
AGNES_IMAGE_MODEL=agnes-image-2.1-flash
# Output allowance for one complete JSON narrative. Increase only if your Agnes plan supports it.
AGNES_TEXT_MAX_TOKENS=6000
AGNES_TIMEOUT_MS=45000
AGNES_IMAGE_TIMEOUT_MS=90000
AGNES_MAX_REQUESTS_PER_MINUTE=30

# ---------------------------------------------------------------------------
# Vite client
# ---------------------------------------------------------------------------
# Use `/api` for the same-origin production deployment. The development server
# proxies this path to the local Express service.
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:8787
VITE_PORT=5173
