{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "fatefork-sites-preview",
  "main": "./worker.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
